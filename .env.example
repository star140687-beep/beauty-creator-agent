APP_ENV=development
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-local-password@localhost:5432/beauty_agent
CHECKPOINT_BACKEND=memory
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
# Ollama is local and does not require an API key. Never commit real provider keys.
LLM_API_KEY=
PLANNER_MODEL=qwen2.5:14b
WRITER_MODEL=qwen2.5:14b
COMPLIANCE_MODEL=qwen2.5:14b
EMBEDDING_MODEL=
EMBEDDING_DIM=
MAX_REVISION_COUNT=2
LOG_LEVEL=INFO
TREND_PROVIDER=none
